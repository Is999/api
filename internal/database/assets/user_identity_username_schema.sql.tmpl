-- 代码资产：创建业务用户账号登录身份索引表。
-- SQL 方言：MySQL 8.0 InnoDB。
-- 调用方：internal/database.DefaultMigrations 通过迁移 runner 执行。
-- 安全边界：仅补建不存在的表，不修改已有表结构或数据；未登记资产可由初始化命令幂等续跑。
CREATE TABLE IF NOT EXISTS `user_identity_username` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT '主键ID',
  `identity_value` varchar(32) NOT NULL COMMENT '归一化用户名',
  `user_id` bigint NOT NULL COMMENT '业务用户雪花ID',
  `user_shard_no` int NOT NULL COMMENT '业务用户ID哈希分片，CRC32(id字符串)%1024',
  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_user_identity_value` (`identity_value`),
  UNIQUE KEY `uk_user_identity_user` (`user_id`),
  KEY `idx_user_identity_shard_user` (`user_shard_no`, `user_id`),
  CONSTRAINT `chk_user_identity_username_user_shard_no` CHECK (`user_shard_no` BETWEEN 0 AND 1023)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='业务用户账号登录身份索引表';
